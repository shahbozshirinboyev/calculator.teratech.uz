# .env.example — bu fayl namuna, serverga yuklamang
# cPanel → Setup Python App → Environment variables bo'limiga qo'shing

# Majburiy — production da False bo'lishi shart
DJANGO_DEBUG=False

# Majburiy — uzun tasodifiy kalit
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Majburiy — vergul bilan ajratilgan domenlar (bo'sh joy bo'lmasin)
DJANGO_ALLOWED_HOSTS=calculator.teratech.uz,www.calculator.teratech.uz

# MUHIM: CSRF xatosini (403 Forbidden) oldini oladi — https:// bilan bo'lishi shart!
# Telefon va boshqa qurilmalardan login qilganda bu qator bo'lmasa 403 xatosi chiqadi
DJANGO_CSRF_TRUSTED_ORIGINS=https://calculator.teratech.uz,https://www.calculator.teratech.uz
